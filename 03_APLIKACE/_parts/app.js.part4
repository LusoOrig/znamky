(function(){
const S = KATALOG.znamky, ZDR = KATALOG.zdroje, CEN = KATALOG.zdroje_cen;
const $ = (s, el=document) => el.querySelector(s);
const $$ = (s, el=document) => Array.from(el.querySelectorAll(s));
const esc = v => (v===null||v===undefined) ? "" : String(v).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const norm = s => (s||"").toString().normalize("NFD").replace(/[̀-ͯ]/g,"").toLowerCase();
const H = v => (v && typeof v === "object" && "hodnota" in v) ? v.hodnota : v;
const fmt = n => (n===null||n===undefined) ? "–" : n.toLocaleString("cs-CZ",{minimumFractionDigits:2,maximumFractionDigits:2});
const eur = n => (n===null||n===undefined) ? "bez ceny" : fmt(n)+" €";

/* ---------- odvozené hodnoty ---------- */
function zemeKratce(z){ return (z||"neurčeno").split(" (")[0]; }
function rokOd(r){ const m=(r||"").match(/(1[6-9]\d\d|20\d\d)/); return m? +m[1] : null; }
function nominalCislo(n){
  if(!n) return null; const s=n.replace(",", ".");
  const m=s.match(/(\d+(?:\.\d+)?)?\s*(½|¼)?/); if(!m || (!m[1] && !m[2])) return null;
  let v=m[1]? parseFloat(m[1]) : 0; if(m[2]==="½") v+=.5; if(m[2]==="¼") v+=.25;
  if(/million/i.test(n)) v*=1e6; else if(/tausend/i.test(n)) v*=1e3;
  return v;
}
const BARVY=[["červená",/červ|karmín|rumělk|cihl/],["růžová",/růž/],["oranžová",/oranž/],["žlutá",/žlut/],["olivová",/oliv/],["zelená",/zelen|tyrkys/],["modrá",/modr|ultramarín|tyrkys|azur/],["fialová",/fial|purpur|lila|vínov/],["hnědá",/hněd|okr|sépi|bistr/],["šedá",/šed/],["černá",/čern/],["vícebarevná",/vícebarev/]];
function barvyRodiny(b){ const t=(b||"").toLowerCase(); if(!t||/viz výřez|neurč/.test(t)) return ["neurčená"];
  const r=BARVY.filter(([,re])=>re.test(t)).map(([n])=>n); return r.length?r:["jiná"]; }
S.forEach((s,i) => {
  if(typeof window!=="undefined"&&window.ZN_IMG){ const b=window.ZN_IMG, fx=p=>p? p.replace(/^\.\.\/01_ZPRACOVANI\//,b):p; s.vyrez_app=fx(s.vyrez_app); s.nahled_app=fx(s.nahled_app); s.foto_app=fx(s.foto_app); }
  const r=s.identifikace||{}, k=r.katalog||{}, o=s.oceneni||{};
  s._i=i;
  s._zeme=zemeKratce(H(r.zeme));
  s._rok=rokOd(H(r.rok_vydani));
  s._nom=H(r.nominal)||""; s._nomN=nominalCislo(s._nom); s._mena=H(r.mena)||"";
  s._mi=H(k.michel)||""; s._pof=""; s._sw=H(k.stampworld)||"";
  const miRange=/ nebo |jedna z/.test(s._mi);
  s._cat=(s._mi&&!(miRange&&s._sw))? s._mi : (s._pof||s._sw||s._mi||"");
  s._predp=!!((k.michel||{}).predpoklad||(k.stampworld||{}).predpoklad);
  s._cats=[s._mi,s._pof,s._sw].filter(Boolean).join(" | ");
  s._jist=(s._cat===s._mi&&s._mi? (k.michel||{}).jistota : (s._cat===s._pof&&s._pof? (k.pofis||{}).jistota : (s._sw? (k.stampworld||{}).jistota : "neurčené")))||"neurčené";
  s._cena=(o.pravdepodobna===null||o.pravdepodobna===undefined)? null : o.pravdepodobna;
  s._stav=H(r.stav)||"neurčeno";
  s._serie=H(r.serie)||""; s._motiv=H(r.motiv)||""; s._barva=H(r.barva)||"";
  s._barvy=barvyRodiny(s._barva);
  s._poskoz=(r.viditelna_poskozeni||[]).length>0;
  s._zach=s._poskoz?"poškozená":"bez zjevných vad";
  s._kontrola=reviewReasons(s);
  s._txt=norm([s.id,H(r.zeme),H(r.serie),H(H(r.motiv)),s._nom,s._mena,H(r.rok_vydani),s._mi,s._sw,H(r.barva),H(r.typ_vydani),s.fotografie,
    (k.michel||{}).poznamka,(k.stampworld||{}).poznamka,r.poznamka,(r.viditelna_poskozeni||[]).join(" "),(s.priznaky_z_inventury||[]).join(" "),
    s.predbezne_z_inventury&&s.predbezne_z_inventury.motiv_popis,o.poznamka,o.duvod].join(" "));
});
const INFO_REV=new Set(["jen číslo StampWorld (Michel neurčen)","předpoklad: nejlevnější varianta"]);
function reviewReasons(s){
  const r=s.identifikace||{}, k=r.katalog||{}, o=s.oceneni||{}, out=[];
  if(!s._cat) out.push("bez katalogového čísla");
  else if(/ nebo |jedna z/.test(s._cat)||(!s._mi&&!s._pof&&/ \/ /.test(s._sw))) out.push("kandidáti katalogového čísla");
  if(s._sw && !s._mi && !s._pof) out.push("jen číslo StampWorld (Michel neurčen)");
  if(s._predp) out.push("předpoklad: nejlevnější varianta");
  const pz=((k.michel||{}).poznamka||"");
  if(s._cat && /odvozen/.test(pz)) out.push("číslo odvozené z pořadí řady");
  if(H(r.zeme) && (r.zeme.jistota!=="ověřené")) out.push("země nejistá");
  if(s._cena===null && s._cat) out.push("neoceněno – nejasná varianta / chybí podklad");
  if(s._poskoz) out.push("poškozená");
  if(/celin/.test(r.typ_vydani||"")||/celin/.test(pz)) out.push("výstřižek z celiny");
  return out;
}

/* ---------- stav filtrů ---------- */
const F = {q:"",zeme:"",serie:"",motiv:"",barva:"",rokOd:"",rokDo:"",mena:"",nom:"",stav:"",zach:"",cena:"",cenaOd:"",cenaDo:"",jist:"",jistC:"",davka:"",skup:false,sort:"poradi",dir:1,size:"m"};
const DEF = JSON.parse(JSON.stringify(F));

function filtered(){
  const nq=norm(F.q).trim().replace(/\s+/g," "), catq=nq.match(/^(mi|sw)\.?\s*(\d+)$/);
  let catRe=catq? new RegExp("(^|[^0-9a-z])"+catq[1]+"\\.?\\s*"+catq[2]+"(?![0-9])") : null;
  if(catRe && !S.some(s=>catRe.test(norm(s._cats)))) catRe=new RegExp("(^|[^0-9a-z])"+catq[1]+"\\.?\\s*"+catq[2]);
  const q=catq? [] : nq.split(/\s+/).filter(Boolean);
  const ro=F.rokOd===""?null:+F.rokOd, rd=F.rokDo===""?null:+F.rokDo, co=F.cenaOd===""?null:+F.cenaOd, cd=F.cenaDo===""?null:+F.cenaDo;
  let L=S.filter(s=>{
    if(catRe && !catRe.test(norm(s._cats))) return false;
    if(q.length && !q.every(w=>s._txt.includes(w))) return false;
    if(F.zeme && s._zeme!==F.zeme) return false;
    if(F.serie && s._serie!==F.serie) return false;
    if(F.motiv && s._motiv!==F.motiv) return false;
    if(F.barva && !s._barvy.includes(F.barva)) return false;
    if(ro!==null && (s._rok===null || s._rok<ro)) return false;
    if(rd!==null && (s._rok===null || s._rok>rd)) return false;
    if(F.mena && s._mena!==F.mena) return false;
    if(F.nom && s._nom!==F.nom) return false;
    if(F.stav && s._stav!==F.stav) return false;
    if(F.zach && s._zach!==F.zach) return false;
    if(F.cena==="ano" && s._cena===null) return false;
    if(F.cena==="ne" && s._cena!==null) return false;
    if(co!==null && (s._cena===null || s._cena<co)) return false;
    if(cd!==null && (s._cena===null || s._cena>cd)) return false;
    if(F.jist && s._jist!==F.jist) return false;
    if(F.jistC && ((s.oceneni||{}).jistota||"bez ocenění")!==F.jistC) return false;
    if(F.davka && s.stav_identifikace!==F.davka) return false;
    if(F.skup && !s.skupina) return false;
    return true;
  });
  const d=F.dir, nl=(a,b)=> (a===null)-(b===null);
  const cmp={
    poradi:(a,b)=>a._i-b._i,
    zeme:(a,b)=>a._zeme.localeCompare(b._zeme,"cs")||nl(a._rok,b._rok)||(a._rok-b._rok)||a._i-b._i,
    rok:(a,b)=>nl(a._rok,b._rok)||(a._rok-b._rok)||a._zeme.localeCompare(b._zeme,"cs")||a._i-b._i,
    nom:(a,b)=>nl(a._nomN,b._nomN)||(a._nomN-b._nomN)||a._mena.localeCompare(b._mena,"cs")||a._i-b._i,
    cena:(a,b)=>nl(a._cena,b._cena)||(a._cena-b._cena)||a._i-b._i,
    cat:(a,b)=>(!a._cat)-(!b._cat)||a._cat.localeCompare(b._cat,"cs",{numeric:true})||a._i-b._i
  }[F.sort];
  L.sort((a,b)=>{ const r=cmp(a,b); // prázdné hodnoty vždy na konci
    const nullsA = F.sort==="cena"?a._cena===null:F.sort==="rok"?a._rok===null:F.sort==="nom"?a._nomN===null:F.sort==="cat"?!a._cat:false;
    const nullsB = F.sort==="cena"?b._cena===null:F.sort==="rok"?b._rok===null:F.sort==="nom"?b._nomN===null:F.sort==="cat"?!b._cat:false;
    if(nullsA!==nullsB) return nullsA?1:-1;
    return d*r; });
  return L;
}

/* ---------- ovládací prvky ---------- */
function opts(sel, values, label){
  const cur=sel.value; sel.innerHTML=`<option value="">${label}</option>`+values.map(([v,t])=>`<option value="${esc(v)}">${esc(t)}</option>`).join("");
  if(values.some(([v])=>v===cur)) sel.value=cur;
}
function counter(fn){ const m=new Map(); S.forEach(s=>{const k=fn(s); if(k!==undefined&&k!=="") m.set(k,(m.get(k)||0)+1);}); return m; }
function initFilters(){
  const z=[...counter(s=>s._zeme)].sort((a,b)=>a[0].localeCompare(b[0],"cs"));
  opts($("#fZeme"), z.map(([k,n])=>[k,`${k} (${n})`]), "Všechny země");
  const m=[...counter(s=>s._mena)].sort((a,b)=>b[1]-a[1]);
  opts($("#fMena"), m.map(([k,n])=>[k,`${k} (${n})`]), "Všechny měny");
  nomOpts(); serieOpts();
  const bc=new Map(); S.forEach(s=>s._barvy.forEach(b=>bc.set(b,(bc.get(b)||0)+1)));
  const bo=[...bc].sort((a,b)=>(a[0]==="neurčená"||a[0]==="jiná")-(b[0]==="neurčená"||b[0]==="jiná")||b[1]-a[1]);
  opts($("#fBarva"), bo.map(([k,n])=>[k,`${k} (${n})`]), "Jakákoli barva");
  const st=[...counter(s=>s._stav)]; opts($("#fStav"), st.map(([k,n])=>[k,`${k} (${n})`]), "Jakýkoli stav");
  const ro=S.map(s=>s._rok).filter(Boolean); $("#fRokOd").placeholder=Math.min(...ro); $("#fRokDo").placeholder=Math.max(...ro);
  const bind=(id,key,ev="change",num=false)=>{ const el=$(id); el.addEventListener(ev,()=>{F[key]=el.type==="checkbox"?el.checked:el.value; if(key==="mena"){F.nom="";nomOpts();} if(key==="zeme"){F.serie="";F.motiv="";serieOpts();} render();}); };
  bind("#q","q","input"); bind("#fZeme","zeme"); bind("#fSerie","serie"); bind("#fMotiv","motiv"); bind("#fBarva","barva"); bind("#fRokOd","rokOd","input"); bind("#fRokDo","rokDo","input"); bind("#fMena","mena"); bind("#fNom","nom");
  bind("#fStav","stav"); bind("#fZach","zach"); bind("#fCena","cena"); bind("#fCenaOd","cenaOd","input"); bind("#fCenaDo","cenaDo","input");
  bind("#fJist","jist"); bind("#fJistC","jistC"); bind("#fDavka","davka"); bind("#fSkup","skup"); bind("#sort","sort");
  $("#dir").addEventListener("click",()=>{F.dir*=-1; $("#dir").textContent=F.dir>0?"↑ vzestupně":"↓ sestupně"; render();});
  $$(".sz").forEach(b=>b.addEventListener("click",()=>{F.size=b.dataset.s; $$(".sz").forEach(x=>x.classList.toggle("on",x===b));
    document.documentElement.style.setProperty("--thumb",{s:"120px",m:"170px",l:"250px"}[F.size]);}));
  $("#reset").addEventListener("click",resetFilters);
}
function serieOpts(){
  const pool=S.filter(s=>!F.zeme||s._zeme===F.zeme);
  const cnt=(fn)=>{const m=new Map(); pool.forEach(s=>{const k=fn(s); if(k) m.set(k,(m.get(k)||0)+1);}); return [...m];};
  const hint=F.zeme?"":" (zvolte zemi pro zúžení)";
  opts($("#fSerie"), cnt(s=>s._serie).sort((a,b)=>a[0].localeCompare(b[0],"cs")).map(([k,n])=>[k,`${k} (${n})`]), "Všechny série"+hint);
  opts($("#fMotiv"), cnt(s=>s._motiv).sort((a,b)=>b[1]-a[1]||a[0].localeCompare(b[0],"cs")).map(([k,n])=>[k,`${k} (${n})`]), "Všechny motivy"+hint);
  $("#fSerie").value=F.serie; $("#fMotiv").value=F.motiv;
}
function nomOpts(){
  const pool=S.filter(s=>!F.mena||s._mena===F.mena);
  const m=new Map(); pool.forEach(s=>{ if(s._nom) m.set(s._nom,(m.get(s._nom)||0)+1); });
  const arr=[...m].sort((a,b)=>(nominalCislo(a[0])||0)-(nominalCislo(b[0])||0)||a[0].localeCompare(b[0],"cs"));
  opts($("#fNom"), arr.map(([k,n])=>[k,`${k} (${n})`]), F.mena?"Všechny nominály":"Všechny nominály (zvolte měnu pro zúžení)");
  $("#fNom").value=F.nom;
}
function resetFilters(){
  Object.assign(F, JSON.parse(JSON.stringify(DEF)));
  ["#q","#fRokOd","#fRokDo","#fCenaOd","#fCenaDo"].forEach(id=>$(id).value="");
  ["#fZeme","#fSerie","#fMotiv","#fBarva","#fMena","#fStav","#fZach","#fCena","#fJist","#fJistC","#fDavka"].forEach(id=>$(id).value="");
  $("#fSkup").checked=false; $("#sort").value="poradi"; $("#dir").textContent="↑ vzestupně"; nomOpts(); serieOpts(); render();
}
function setFilter(key,val){ F[key]=val; const map={serie:"#fSerie",motiv:"#fMotiv",barva:"#fBarva",zeme:"#fZeme",jist:"#fJist",cena:"#fCena",stav:"#fStav",zach:"#fZach"}; if(key==="zeme"){F.serie="";F.motiv="";serieOpts();} if(map[key]) $(map[key]).value=val; show("album"); render(); }

/* ---------- vykreslení alba ---------- */
let current=[];
function card(s){
  const r=s.identifikace||{}, rok=H(r.rok_vydani)||"rok neurčen";
  const flag = s.skupina ? `<span class="flag">${esc(s.skupina_typ||"skupina")}</span>` : "";
  return `<article class="card" tabindex="0" data-id="${s.id}" aria-label="${esc(s.id)}">
    <div class="mount">${flag}<img loading="lazy" decoding="async" src="${esc(s.nahled_app)}" alt="${esc(s.id+' – '+s._zeme)}"></div>
    <div class="cap">
      <div class="c1">${esc(s._nom||"nominál neurčen")} · ${esc(rok)}</div>
      <div class="c2" title="${esc(H(r.serie)||H(r.motiv)||"")}">${esc(H(r.serie)||H(r.motiv)||"série neurčena")}</div>
      <div class="c3"><span class="cat ${s._cat?"":"none"}"><span class="dot ${esc(s._jist)}"></span>${esc(s._cat||"bez kat. čísla")}</span>
        <span class="price ${s._cena===null?"none":""}">${s._cena===null?"–":esc(fmt(s._cena))+" €"}</span></div>
      <div class="c2" style="color:var(--muted)">${esc(s.id)} · ${esc(s._zeme)}</div>
    </div></article>`;
}
function render(){
  current=filtered();
  $("#count").textContent=`Zobrazeno ${current.length} z ${S.length} známek`;
  const g=$("#grid");
  if(!current.length){ g.innerHTML=`<div class="empty">Žádná známka neodpovídá filtrům.</div>`; chips(); return; }
  let html="", last=null;
  const head = F.sort==="zeme"? s=>s._zeme : F.sort==="rok"? s=>s._rok? (Math.floor(s._rok/10)*10)+"–"+(Math.floor(s._rok/10)*10+9) : "Rok neurčen" : null;
  const cnt={}; if(head) current.forEach(s=>{const h=head(s); cnt[h]=(cnt[h]||0)+1;});
  current.forEach(s=>{ if(head){ const h=head(s); if(h!==last){ html+=`<div class="page-head"><h2>${esc(h)}</h2><span>${cnt[h]} ks</span></div>`; last=h; } } html+=card(s); });
  g.innerHTML=html; chips();
}
function chips(){
  const names={q:"Hledat",zeme:"Země",serie:"Série",motiv:"Motiv",barva:"Barva",rokOd:"Rok od",rokDo:"Rok do",mena:"Měna",nom:"Nominál",stav:"Stav",zach:"Zachovalost",cena:"Ocenění",cenaOd:"Cena od",cenaDo:"Cena do",jist:"Jistota kat. čísla",jistC:"Jistota ocenění",davka:"Dávka",skup:"Jen skupiny"};
  const c=Object.keys(names).filter(k=>F[k]!==DEF[k]).map(k=>`<span class="chip" data-k="${k}">${names[k]}: ${esc(F[k]===true?"ano":F[k]==="ano"?"oceněné":F[k]==="ne"&&k==="cena"?"neoceněné":F[k])}</span>`);
  $("#chips").innerHTML=c.join("");
  $$("#chips .chip").forEach(ch=>ch.addEventListener("click",()=>{const k=ch.dataset.k; F[k]=DEF[k];
    const el={q:"#q",zeme:"#fZeme",serie:"#fSerie",motiv:"#fMotiv",barva:"#fBarva",rokOd:"#fRokOd",rokDo:"#fRokDo",mena:"#fMena",nom:"#fNom",stav:"#fStav",zach:"#fZach",cena:"#fCena",cenaOd:"#fCenaOd",cenaDo:"#fCenaDo",jist:"#fJist",jistC:"#fJistC",davka:"#fDavka",skup:"#fSkup"}[k];
    const e=$(el); if(e.type==="checkbox") e.checked=false; else e.value=""; if(k==="mena") nomOpts(); if(k==="zeme"){F.serie="";F.motiv="";serieOpts();} render();}));
}

/* ---------- detail ---------- */
let detId=null, mode="crop";
function J(f){ return f&&f.jistota? `<span class="j ${esc(f.jistota)}">${esc(f.jistota)}</span>` : ""; }
function srcList(f){ const z=((f&&f.zdroje)||[]).filter(x=>x!=="FOTO"); return z.length? `<small>Zdroj: ${z.map(id=>{const d=ZDR[id]; return d? (d.url?`<a href="${esc(d.url)}" target="_blank" rel="noopener">${esc(id)}</a>`:`<span title="${esc(d.nazev)}">${esc(id)}</span>`):esc(id);}).join(", ")}</small>`:""; }
function row(label,f,extra){ if(f===undefined||f===null) return ""; const v=H(f); return `<dt>${label}</dt><dd>${v===null||v===""?'<i style="color:var(--muted)">neurčeno</i>':esc(v)}${J(f)}${f.poznamka?`<small>${esc(f.poznamka)}</small>`:""}${srcList(f)}${extra||""}</dd>`; }
function openDetail(id, push=true){
  const s=S.find(x=>x.id===id); if(!s) return; detId=id;
  if(push && location.hash!=="#"+id) history.replaceState(null,"","#"+id);
  const r=s.identifikace||{}, k=r.katalog||{}, o=s.oceneni||{};
  const catb=(lbl,f)=>{const v=H(f); return `<div class="catbox ${v?"":"na"}"><span>${lbl}</span><b>${esc(v||"neurčeno")}</b>${v?J(f):""}</div>`;};
  const notes=[ (k.michel||{}).poznamka, (k.stampworld||{}).poznamka && H(k.stampworld)? "StampWorld: "+k.stampworld.poznamka:null, r.poznamka ].filter(Boolean);
  let val;
  if(s._cena!==null){
    const mx=Math.max(o.max||0,.01), p=x=>Math.min(100,(x/mx)*100);
    val=`<div class="val"><div class="big">${fmt(o.pravdepodobna)} € <small>pravděpodobná tržní cena</small></div>
      <div class="range"><b style="left:${p(o.min)}%;width:${p(o.max)-p(o.min)}%"></b><i style="left:calc(${p(o.pravdepodobna)}% - 1px)"></i></div>
      <div class="range-l"><span>min. ${fmt(o.min)} €</span><span>max. ${fmt(o.max)} €</span></div>
      <dl class="kv" style="margin-top:10px">
        <dt>Jistota ocenění</dt><dd>${esc(o.jistota||"–")}</dd>
        <dt>Typ ceny</dt><dd>${esc(o.typ_ceny||"–")}</dd>
        <dt>Metoda</dt><dd>${esc(o.metoda||"–")}</dd>
        <dt>Srovnávané kusy</dt><dd>${esc(o.stav_srovnavanych||"–")}</dd>
        <dt>Datum ověření</dt><dd>${esc(o.datum_overeni||"–")}</dd>
        ${o.poznamka?`<dt>Poznámka</dt><dd>${esc(o.poznamka)}</dd>`:""}
      </dl></div>`;
  } else {
    val=`<div class="val"><div class="big" style="font-size:22px">Neoceněno</div><div class="note">${esc(o.duvod||"bez podkladů")}</div></div>`;
  }
  const zs=(o.zdroje||[]);
  const srcs = zs.length? `<ul class="src">${zs.map(id=>{const c=CEN[id]||{}; return `<li><span class="ttag ${esc(c.typ||"")}">${esc(c.typ||"zdroj")}</span><b>${esc(id)}</b> – ${esc(c.n||"")}${c.cena!=null?` · <b>${esc(c.cena)} ${esc(c.mena||"")}</b>`:""}${c.stav?` · <i>${esc(c.stav)}</i>`:""}${c.url?` · <a href="${esc(c.url)}" target="_blank" rel="noopener">odkaz ↗</a>`:""}</li>`;}).join("")}</ul>` : "";
  const grp = s.skupina? `<dt>Skupina</dt><dd>${esc(s.skupina)} (${esc(s.skupina_typ||"")}) – ${S.filter(x=>x.skupina===s.skupina).map(x=>`<a href="#${x.id}" data-go="${x.id}">${x.id}</a>`).join(", ")}</dd>`:"";
  $("#entry").innerHTML=`<button class="close" id="close" title="Zavřít (Esc)">×</button>
    <div class="eid">${esc(s.id)} · ${esc(s.stav_identifikace)}</div>
    <h2>${esc(H(r.zeme)||"Země neurčena")}</h2>
    <div class="sub">${esc(s._nom||"")}${s._nom?" · ":""}${esc(H(r.rok_vydani)||"rok neurčen")} · ${esc(H(r.serie)||"série neurčena")}</div>
    <div class="catline">${catb("Michel",k.michel)}${catb("StampWorld",k.stampworld)}</div>
    ${notes.map(n=>`<div class="note">${esc(n)}</div>`).join("")}
    <div class="sec"><h4>Popis známky</h4><dl class="kv">
      ${row("Země",r.zeme)}${row("Nominál",r.nominal)}${row("Měna",r.mena)}${row("Rok vydání",r.rok_vydani)}${row("Série",r.serie)}${row("Motiv",r.motiv)}
      <dt>Typ vydání</dt><dd>${esc(r.typ_vydani||"neurčeno")}</dd>${row("Barva",r.barva)}
    </dl></div>
    <div class="sec"><h4>Filatelistické údaje</h4><dl class="kv">
      ${row("Stav",r.stav)}${row("Zachovalost",r.zachovalost)}
      <dt>Poškození</dt><dd>${(r.viditelna_poskozeni||[]).length? esc(r.viditelna_poskozeni.join("; ")) : "bez zjevných vad na fotografii"}</dd>
      ${row("Perforace",r.perforace)}${row("Vodoznak",r.vodoznak)}${row("Tisk / varianta",r.tisk)}
      ${(s.priznaky_z_inventury||[]).length?`<dt>Inventura</dt><dd>${esc(s.priznaky_z_inventury.join("; "))}</dd>`:""}
      ${s._kontrola.length?`<dt>Ke kontrole</dt><dd>${esc(s._kontrola.join("; "))}</dd>`:""}
    </dl></div>
    <div class="sec"><h4>Ocenění</h4>${val}${srcs}</div>
    <div class="sec"><h4>Evidence</h4><dl class="kv">
      <dt>Fotografie</dt><dd>${esc(s.fotografie)}, pořadí ${esc(s.poradi_na_fotografii)}</dd>
      <dt>Souřadnice výřezu</dt><dd>${s.souradnice_vyrezu_px? esc(`x ${s.souradnice_vyrezu_px.x0}–${s.souradnice_vyrezu_px.x1}, y ${s.souradnice_vyrezu_px.y0}–${s.souradnice_vyrezu_px.y1} px`):"–"}${s.otoceni?` <small>výřez otočen o ${s.otoceni}°</small>`:""}</dd>
      ${grp}
      <dt>Výřez</dt><dd><a href="${esc(s.vyrez_app)}" target="_blank">${esc(s.vyrez)}</a></dd>
      <dt>Originál</dt><dd>${WEB? esc(s.originalni_fotografie)+" (originál HEIC jen v lokální verzi)" : `<a href="${esc(s.original_app)}" target="_blank">${esc(s.originalni_fotografie)}</a>`}</dd>
    </dl></div>
    <div class="sec"><h4>Historie záznamu</h4><ul class="hist">${(s.historie||[]).map(h=>`<li>${esc(h.datum)} – ${esc(h.zmena)}</li>`).join("")}</ul></div>`;
  $("#close").onclick=closeDetail;
  $$("#entry [data-go]").forEach(a=>a.addEventListener("click",e=>{e.preventDefault();openDetail(a.dataset.go);}));
  $("#oFull").href=s.vyrez_app; $("#oHeic").href=s.original_app; if(WEB) $("#oHeic").style.display="none"; $("#oJpg").href=s.foto_app;
  setMode(mode); $("#overlay").classList.remove("hidden"); document.body.style.overflow="hidden";
}
function setMode(m){
  mode=m; const s=S.find(x=>x.id===detId); if(!s) return;
  $$("#seg button").forEach(b=>b.classList.toggle("on",b.dataset.m===m));
  const st=$("#stage");
  if(m==="crop"){ st.innerHTML=`<img class="crop" id="bigimg" src="${esc(s.vyrez_app)}" alt="${esc(s.id)}">`;
    $("#vfoot").textContent=`Samostatný výřez v plném rozlišení · ${s.vyrez}`; }
  else { const b=s.bbox; st.innerHTML=`<div class="photo"><img id="bigimg" src="${esc(s.foto_app)}" alt="${esc(s.fotografie)}">${b?`<div class="hl" style="left:${b[0]}%;top:${b[1]}%;width:${b[2]}%;height:${b[3]}%"></div>`:""}</div>`;
    $("#vfoot").textContent=`Původní fotografie ${s.fotografie} (náhled JPEG${WEB?"":"; originál HEIC otevřete tlačítkem nahoře"}) · známka č. ${s.poradi_na_fotografii} je zvýrazněna`; }
}
function step(d){ const L=current.length?current:S; let i=L.findIndex(x=>x.id===detId); if(i<0) i=0; const n=L[(i+d+L.length)%L.length]; openDetail(n.id); }
function closeDetail(){ $("#overlay").classList.add("hidden"); document.body.style.overflow=""; detId=null; history.replaceState(null,"",location.pathname+location.search); }

/* ---------- statistiky ---------- */
function bars(rows, max, alt, link){
  return `<div class="bars">${rows.map(([l,v,t])=>`<div class="lbl ${link?"link":""}" ${link?`data-zeme="${esc(l)}"`:""} title="${esc(l)}">${esc(l)}</div><div class="bar"><b class="${alt?"alt":""}" style="width:${max?Math.max(1,v/max*100):0}%"></b></div><div class="num">${esc(t!==undefined?t:v)}</div>`).join("")}</div>`;
}
function stats(){
  const val=S.filter(s=>s._cena!==null), sum=k=>val.reduce((a,s)=>a+(s.oceneni[k]||0),0);
  const byZ=[...counter(s=>s._zeme)].sort((a,b)=>b[1]-a[1]);
  const vZ=new Map(); val.forEach(s=>vZ.set(s._zeme,(vZ.get(s._zeme)||0)+s._cena));
  const vZr=[...vZ].sort((a,b)=>b[1]-a[1]);
  const dec=new Map(); S.forEach(s=>{const k=s._rok?Math.floor(s._rok/10)*10:null; const key=k===null?"neurčeno":k+"–"+(k+9); dec.set(key,(dec.get(key)||0)+1);});
  const decR=[...dec].sort((a,b)=>a[0].localeCompare(b[0]));
  const jc=counter(s=>s._jist), col={"ověřené":"#3f7d4e","pravděpodobné":"#c08a1e","neurčené":"#b9b2a6"};
  let acc=0; const seg=["ověřené","pravděpodobné","neurčené"].map(k=>{const v=(jc.get(k)||0)/S.length*360; const sgm=`${col[k]} ${acc}deg ${acc+v}deg`; acc+=v; return sgm;}).join(",");
  const top=val.slice().sort((a,b)=>b._cena-a._cena||b.oceneni.max-a.oceneni.max).slice(0,15);
  const ser=[...counter(s=>H((s.identifikace||{}).serie)?s._zeme+" – "+H(s.identifikace.serie):undefined)].sort((a,b)=>b[1]-a[1]).slice(0,15);
  const fotos=[...counter(s=>s.fotografie)];
  $("#stats").innerHTML=`<div class="panels">
   <div class="panel"><h3>Sbírka v číslech</h3><dl class="kv">
     <dt>Známek celkem</dt><dd><b>${S.length}</b> z ${fotos.length} fotografií</dd>
     <dt>Zemí</dt><dd>${byZ.length}</dd>
     <dt>S katalogovým číslem</dt><dd>${S.filter(s=>s._cat).length} (${Math.round(S.filter(s=>s._cat).length/S.length*100)} %)</dd>
     <dt>Oceněno</dt><dd>${val.length}</dd>
     <dt>Pravděpodobná hodnota</dt><dd><b>${fmt(sum("pravdepodobna"))} €</b> <small>rozpětí ${fmt(sum("min"))} – ${fmt(sum("max"))} € (jen oceněné kusy)</small></dd>
     <dt>Spojené kusy</dt><dd>${new Set(S.filter(s=>s.skupina).map(s=>s.skupina)).size} skupin, ${S.filter(s=>s.skupina).length} známek</dd>
     <dt>Poškozené</dt><dd>${S.filter(s=>s._poskoz).length}</dd>
     <dt>Nejstarší / nejmladší</dt><dd>${Math.min(...S.map(s=>s._rok).filter(Boolean))} / ${Math.max(...S.map(s=>s._rok).filter(Boolean))}</dd>
   </dl><p class="lead" style="margin-top:12px">Ceny jsou orientační odhady (EUR) z katalogových hodnot, nabídek a realizovaných prodejů – viz detail každé známky.</p></div>
   <div class="panel"><h3>Jistota katalogového čísla</h3><div class="donut"><div class="ring" style="background:conic-gradient(${seg})"></div>
     <div class="legend">${["ověřené","pravděpodobné","neurčené"].map(k=>`<div><span class="dot ${k}"></span>${k}: <b>${jc.get(k)||0}</b> <a href="#" data-jist="${k}">zobrazit</a></div>`).join("")}</div></div></div>
   <div class="panel"><h3>Známky podle zemí</h3><p class="lead">Kliknutím na zemi zobrazíte její známky v albu.</p>${bars(byZ.slice(0,20),byZ[0][1],false,true)}${byZ.length>20?`<p class="lead" style="margin-top:8px">+ dalších ${byZ.length-20} zemí s ${byZ.slice(20).reduce((a,b)=>a+b[1],0)} známkami</p>`:""}</div>
   <div class="panel"><h3>Hodnota podle zemí (pravděpodobná, EUR)</h3>${bars(vZr.map(([k,v])=>[k,v,fmt(v)]),vZr.length?vZr[0][1]:0,true,true)}</div>
   <div class="panel"><h3>Známky podle desetiletí vydání</h3>${bars(decR,Math.max(...decR.map(x=>x[1])),true)}</div>
   <div class="panel"><h3>Nejčastější série</h3>${bars(ser,ser.length?ser[0][1]:0)}</div>
   <div class="panel" style="grid-column:1/-1"><h3>Nejcennější kusy (podle pravděpodobné ceny)</h3>
     <table class="t"><tr><th></th><th>ID</th><th>Země</th><th>Nominál / rok</th><th>Katalog</th><th class="num-r">Min</th><th class="num-r">Pravd.</th><th class="num-r">Max</th><th>Jistota</th></tr>
     ${top.map(s=>`<tr class="clk" data-id="${s.id}"><td><img loading="lazy" src="${esc(s.nahled_app)}" alt=""></td><td>${s.id}</td><td>${esc(s._zeme)}</td><td>${esc(s._nom)} · ${esc(H(s.identifikace.rok_vydani)||"")}</td><td>${esc(s._cat)}</td><td class="num-r">${fmt(s.oceneni.min)}</td><td class="num-r"><b>${fmt(s._cena)}</b></td><td class="num-r">${fmt(s.oceneni.max)}</td><td>${esc(s.oceneni.jistota)}</td></tr>`).join("")}</table></div>
  </div>`;
  $$("#stats [data-zeme]").forEach(e=>e.addEventListener("click",()=>setFilter("zeme",e.dataset.zeme)));
  $$("#stats [data-jist]").forEach(e=>e.addEventListener("click",ev=>{ev.preventDefault();setFilter("jist",e.dataset.jist);}));
  $$("#stats tr[data-id]").forEach(e=>e.addEventListener("click",()=>openDetail(e.dataset.id)));
}

/* ---------- přehled neurčených a ke kontrole ---------- */
let revKey="bez katalogového čísla";
function review(){
  const keys=["bez katalogového čísla","kandidáti katalogového čísla","číslo odvozené z pořadí řady","jen číslo StampWorld (Michel neurčen)","předpoklad: nejlevnější varianta","neoceněno – nejasná varianta / chybí podklad","země nejistá","poškozená","výstřižek z celiny"];
  const cnt=k=>S.filter(s=>s._kontrola.includes(k)).length;
  const L=S.filter(s=>s._kontrola.includes(revKey));
  const groups=new Map();
  L.forEach(s=>{ const r=s.identifikace||{}; const g = revKey==="bez katalogového čísla"? s._zeme+" – "+(H(r.serie)||"série neurčena")
      : revKey==="kandidáti katalogového čísla"||revKey==="číslo odvozené z pořadí řady"||revKey.startsWith("jen číslo")||revKey.startsWith("předpoklad")? s._zeme+" – "+s._cat
      : revKey.startsWith("neoceněno")? (s.oceneni.duvod||"") : s._zeme;
    if(!groups.has(g)) groups.set(g,[]); groups.get(g).push(s); });
  const why=s=>{const k=(s.identifikace||{}).katalog||{}; return revKey.startsWith("neoceněno")?"":((k.michel||{}).poznamka||(k.stampworld||{}).poznamka||(revKey==="poškozená"?(s.identifikace.viditelna_poskozeni||[]).join("; "):""));};
  $("#review").innerHTML=`<div class="panel" style="margin-bottom:18px"><h3>Neurčené známky a kusy ke kontrole</h3>
    <p class="lead">Kategorie se mohou překrývat. Kliknutím na miniaturu otevřete detail známky. Podrobný textový přehled je v <code>04_REPORTY/neurcene-znamky.md</code>.</p>
    <div class="review-tabs">${keys.map(k=>`<button data-k="${esc(k)}" class="${k===revKey?"on":""}">${esc(k)}<b>${cnt(k)}</b></button>`).join("")}</div>
    ${[...groups].sort((a,b)=>b[1].length-a[1].length).map(([g,arr])=>`<div class="group"><h4>${esc(g)} <span style="color:var(--muted);font-size:13px">(${arr.length})</span></h4>
      ${why(arr[0])?`<p class="why">${esc(why(arr[0]))}</p>`:""}
      <div class="strip">${arr.map(s=>`<div class="mini" data-id="${s.id}" title="${esc(s.id+' · '+(s._nom||'')+' · '+s._zeme)}"><img loading="lazy" src="${esc(s.nahled_app)}" alt="${esc(s.id)}"></div>`).join("")}</div></div>`).join("")}
  </div>`;
  $$("#review .review-tabs button").forEach(b=>b.addEventListener("click",()=>{revKey=b.dataset.k; review();}));
  $$("#review .mini").forEach(e=>e.addEventListener("click",()=>openDetail(e.dataset.id)));
}
function sources(){
  const used=new Set(); S.forEach(s=>{const r=s.identifikace||{}; Object.values(r).forEach(v=>{if(v&&v.zdroje) v.zdroje.forEach(x=>used.add(x));}); const k=r.katalog||{}; Object.values(k).forEach(v=>{if(v&&v.zdroje) v.zdroje.forEach(x=>used.add(x));});});
  const uc=new Map(); S.forEach(s=>((s.oceneni||{}).zdroje||[]).forEach(x=>uc.set(x,(uc.get(x)||0)+1)));
  $("#sources").innerHTML=`<div class="panels"><div class="panel" style="grid-column:1/-1"><h3>Identifikační zdroje</h3><table class="t"><tr><th>ID</th><th>Zdroj</th><th>Typ</th></tr>
    ${Object.entries(ZDR).map(([id,d])=>`<tr><td>${esc(id)}</td><td>${d.url?`<a href="${esc(d.url)}" target="_blank" rel="noopener">${esc(d.nazev)}</a>`:esc(d.nazev)}</td><td>${esc(d.typ||"")}</td></tr>`).join("")}</table></div>
    <div class="panel" style="grid-column:1/-1"><h3>Cenové podklady</h3><p class="lead">katalogová = katalog (horní orientace) · nabídková = požadovaná cena · realizovaná = skutečný prodej · neprodáno = nabídka bez kupce</p>
    <table class="t"><tr><th>ID</th><th>Typ</th><th>Podklad</th><th class="num-r">Cena</th><th class="num-r">Použito u</th></tr>
    ${Object.entries(CEN).map(([id,c])=>`<tr><td>${esc(id)}</td><td><span class="ttag ${esc(c.typ)}">${esc(c.typ)}</span></td><td>${c.url?`<a href="${esc(c.url)}" target="_blank" rel="noopener">${esc(c.n)}</a>`:esc(c.n)}</td><td class="num-r">${c.cena!=null?esc(c.cena)+" "+esc(c.mena):""}</td><td class="num-r">${uc.get(id)||0}</td></tr>`).join("")}</table></div></div>`;
}

/* ---------- navigace ---------- */
function show(v){
  ["album","stats","review","sources"].forEach(x=>$("#view-"+x).classList.toggle("hidden",x!==v));
  $$("nav.tabs button").forEach(b=>b.classList.toggle("active",b.dataset.v===v));
  if(v==="stats") stats(); if(v==="review") review(); if(v==="sources") sources();
  window.scrollTo(0,0);
}
function init(){
  const val=S.filter(s=>s._cena!==null);
  $("#kpis").innerHTML=[[S.length,"známek"],[new Set(S.map(s=>s._zeme)).size,"zemí"],[S.filter(s=>s._cat).length,"s kat. číslem"],
    [fmt(val.reduce((a,s)=>a+s._cena,0))+" €","pravděp. hodnota"]].map(([b,t])=>`<div class="kpi"><b>${b}</b><span>${t}</span></div>`).join("");
  $("#revBadge").textContent=S.filter(s=>s._kontrola.some(k=>!INFO_REV.has(k))).length;
  $("#gen").textContent=`Data: 02_KATALOG/znamky.json, verze ${KATALOG.verze}, ${KATALOG.datum} · vygenerováno ${KATALOG.vygenerovano}`;
  initFilters(); render();
  $("#grid").addEventListener("click",e=>{const c=e.target.closest(".card"); if(c) openDetail(c.dataset.id);});
  $("#grid").addEventListener("keydown",e=>{if(e.key==="Enter"){const c=e.target.closest(".card"); if(c) openDetail(c.dataset.id);}});
  $$("nav.tabs button").forEach(b=>b.addEventListener("click",()=>show(b.dataset.v)));
  $$("#seg button").forEach(b=>b.addEventListener("click",()=>setMode(b.dataset.m)));
  $("#prev").onclick=()=>step(-1); $("#next").onclick=()=>step(1);
  $("#overlay").addEventListener("click",e=>{if(e.target.id==="overlay") closeDetail();});
  document.addEventListener("keydown",e=>{ if($("#overlay").classList.contains("hidden")) return;
    if(e.key==="Escape") closeDetail(); else if(e.key==="ArrowLeft") step(-1); else if(e.key==="ArrowRight") step(1); else if(e.key==="o") setMode(mode==="crop"?"photo":"crop"); });
  const h=decodeURIComponent(location.hash.slice(1)); if(/^STAMP-\d{4}$/.test(h)) openDetail(h,false);
  window.addEventListener("hashchange",()=>{const h=location.hash.slice(1); if(/^STAMP-\d{4}$/.test(h)&&h!==detId) openDetail(h,false);});
  window.__katalog={S,F,filtered,render,openDetail,setMode,setFilter,resetFilters,show}; // pro testy
}
document.addEventListener("DOMContentLoaded",init);
})();
